# ===== 必填 =====
# DeepSeek API Key（仅在服务端读取，绝不会下发到浏览器）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 可选 =====
# 服务监听端口
# PORT=8080
# DeepSeek 模型
# DEEPSEEK_MODEL=deepseek-chat
# DeepSeek API 地址（自建中转时可改）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
#
# 限频：同一 IP 在时间窗内的最多请求次数
# 设为 false（或 0 / off）表示关闭限频
# CITATION_RATE_MAX=2       AI 引用实测，默认 2 次/窗
# FETCH_RATE_MAX=20         页面抓取，默认 20 次/窗
# RATE_WINDOW_MS=60000      时间窗大小（毫秒），默认 60000 即 1 分钟
